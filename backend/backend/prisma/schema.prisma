generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model ApiUsage {
  id            String   @id
  userId        String
  provider      String
  model         String?
  tokens        Int?
  estimatedCost Float?
  createdAt     DateTime @default(now())
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([model])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id
  projectId String
  role      String
  content   String
  createdAt DateTime @default(now())
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model Deployment {
  id            String           @id
  projectId     String
  provider      String
  deploymentUrl String?
  deploymentId  String?
  status        DeploymentStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime
  Project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
}

model Generation {
  id         String           @id
  projectId  String
  userPrompt String
  agent      String
  input      Json?
  output     Json?
  status     GenerationStatus @default(PENDING)
  error      String?
  tokenUsage Int?
  createdAt  DateTime         @default(now())
  Project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([agent])
  @@index([status])
  @@index([createdAt])
}

model Project {
  id            String        @id
  userId        String
  name          String
  description   String?
  initialPrompt String
  status        ProjectStatus @default(DRAFT)
  framework     String        @default("nextjs-react-tailwind")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  ChatMessage   ChatMessage[]
  Deployment    Deployment[]
  Generation    Generation[]
  User          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  Website       Website[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String          @id
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           UserRole        @default(USER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  Account        Account[]
  ApiUsage       ApiUsage[]
  Project        Project[]
  Session        Session[]
  AdminAuditLogs AdminAuditLog[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  AdminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Website {
  id            String        @id
  projectId     String
  title         String
  description   String?
  theme         String        @default("modern")
  colorPalette  Json
  fontFamily    String        @default("Inter")
  structure     Json
  generatedCode Json?
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  Project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  WebsitePage   WebsitePage[]

  @@index([projectId])
  @@index([createdAt])
}

model WebsitePage {
  id            String   @id
  websiteId     String
  name          String
  slug          String
  pageType      String   @default("standard")
  content       Json
  generatedCode String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Website       Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, slug])
  @@index([websiteId])
}

enum UserRole {
  USER
  ADMIN
}

enum DeploymentStatus {
  PENDING
  BUILDING
  READY
  ERROR
}

enum GenerationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ProjectStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}
